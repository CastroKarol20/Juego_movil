{
  "info": {
    "name": "MindForge API - Collection",
    "_postman_id": "mindforge-collection",
    "description": "Colección completa para pruebas: auth, juegos, ranking y más.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" },
        "description": "Registra un nuevo usuario. Devuelve usuario y token (si aplica)."
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" },
        "description": "Login: guarda el token en la variable de colección 'token' al recibirlo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK', function () { pm.response.to.have.status(200); });",
              "var json;",
              "try { json = pm.response.json(); } catch (e) { json = null; }",
              "if (json && (json.token || json.accessToken)) {",
              "  var t = json.token || json.accessToken;",
              "  pm.collectionVariables.set('token', t);",
              "  console.log('Token guardado en collectionVariables');",
              "} else {",
              "  console.log('No se encontró token en la respuesta');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Current User",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] },
        "description": "Devuelve los datos del usuario autenticado. Requiere Bearer token."
      }
    },
    {
      "name": "List Challenges",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/challenges", "host": ["{{baseUrl}}"], "path": ["api","challenges"] },
        "description": "Listado de desafíos. Usar para obtener challengeId real."
      }
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Got challenges', function () { pm.response.to.have.status(200); });",
              "var json = [];",
              "try { json = pm.response.json(); } catch (e) { json = []; }",
              "if (Array.isArray(json) && json.length) {",
              "  var id = json[0]._id || json[0].id || null;",
              "  if (id) { pm.collectionVariables.set('challengeId', id); console.log('challengeId guardado:', id); }",
              "} else {",
              "  console.log('No se encontraron challenges en la respuesta');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Challenge",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/challenges", "host": ["{{baseUrl}}"], "path": ["api","challenges"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Reto de ejemplo desde Postman\",\n  \"description\": \"Crear un reto para pruebas\",\n  \"category\": \"logica\",\n  \"difficulty\": \"facil\",\n  \"question\": \"¿Cuál es el siguiente número: 2,4,8,16,... ?\",\n  \"correctAnswer\": \"32\",\n  \"alternativeAnswers\": [\"treinta y dos\", \"32\"],\n  \"hint\": \"Es una potencia de 2\",\n  \"timeLimit\": 60,\n  \"points\": 100,\n  \"xpReward\": 20,\n  \"requiredLevel\": 1,\n  \"icon\": \"🎯\",\n  \"order\": 1,\n  \"isActive\": true\n}"
        },
        "description": "Crea un nuevo challenge. Requiere token (protect middleware)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create challenge OK', function () { pm.response.to.have.status(201); });",
              "var json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "var id = json._id || json.id || null;",
              "if (id) { pm.collectionVariables.set('challengeId', id); console.log('challengeId guardado:', id); } else { console.log('No se encontró _id en la respuesta'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Start Game",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/games/start", "host": ["{{baseUrl}}"], "path": ["api","games","start"] },
        "body": { "mode": "raw", "raw": "{ \"challengeId\": \"{{challengeId}}\" }" },
        "description": "Inicia una partida para el challenge indicado. Usar `List Challenges` para obtener IDs."
      }
    },
    {
      "name": "Submit Answer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/games/submit", "host": ["{{baseUrl}}"], "path": ["api","games","submit"] },
        "body": { "mode": "raw", "raw": "{ \"challengeId\": \"{{challengeId}}\", \"answer\": \"respuesta\", \"timeSpent\": 30 }" },
        "description": "Enviar respuesta de un jugador."
      }
    },
    {
      "name": "List Ranking",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/ranking", "host": ["{{baseUrl}}"], "path": ["api","ranking"] },
        "description": "Obtiene el ranking global."
      }
    },
    {
      "name": "Get User By ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/profile/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","profile","{{userId}}"] },
        "description": "Obtiene información de un usuario por ID. Rellenar variable 'userId'. Usa /api/users/profile/:userId."
      }
    },
    {
      "name": "Update Password",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/auth/update-password", "host": ["{{baseUrl}}"], "path": ["api","auth","update-password"] },
        "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newPassword456\"\n}" },
        "description": "Actualizar contraseña del usuario autenticado."
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Password updated or OK', function () { pm.expect(pm.response.code).to.be.oneOf([200,204]); });" ] } } ]
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api","users","profile"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"nuevoUsuario\",\n  \"bio\": \"Bio de prueba\"\n}" },
        "description": "Actualizar perfil del usuario autenticado."
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Profile updated', function () { pm.response.to.have.status(200); });" ] } } ]
    },
    {
      "name": "Get My Stats",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/stats", "host": ["{{baseUrl}}"], "path": ["api","users","stats"] },
        "description": "Estadísticas del usuario autenticado."
      }
    },
    {
      "name": "Get User Achievements",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/achievements", "host": ["{{baseUrl}}"], "path": ["api","users","achievements"] },
        "description": "Logros del usuario autenticado."
      }
    },
    {
      "name": "Get Challenges Available",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/challenges/available", "host": ["{{baseUrl}}"], "path": ["api","challenges","available"] },
        "description": "Retos disponibles para el usuario según nivel."
      }
    },
    {
      "name": "Get Challenge By ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/challenges/{{challengeId}}", "host": ["{{baseUrl}}"], "path": ["api","challenges","{{challengeId}}"] },
        "description": "Obtener detalle de un challenge por ID."
      }
    },
    {
      "name": "Games History",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/games/history", "host": ["{{baseUrl}}"], "path": ["api","games","history"] },
        "description": "Historial de partidas del usuario."
      }
    },
    {
      "name": "Game Detail",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/games/history/{{gameId}}", "host": ["{{baseUrl}}"], "path": ["api","games","history","{{gameId}}"] },
        "description": "Detalle de una partida por ID."
      }
    },
    {
      "name": "Ranking My Position",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/ranking/my-position", "host": ["{{baseUrl}}"], "path": ["api","ranking","my-position"] },
        "description": "Posición del usuario en el ranking."
      }
    },
    {
      "name": "Ranking By Category",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/ranking/category/{{category}}", "host": ["{{baseUrl}}"], "path": ["api","ranking","category","{{category}}"] },
        "description": "Ranking filtrado por categoría (usar valores válidos)."
      }
    },
    {
      "name": "Create Achievement",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/achievements", "host": ["{{baseUrl}}"], "path": ["api","achievements"] },
        "body": { "mode": "raw", "raw": "{\n  \"achievementId\": \"first_win\",\n  \"name\": \"Primera victoria\",\n  \"description\": \"Gana tu primer juego\",\n  \"category\": \"victorias\",\n  \"condition\": { \"type\": \"games_won\", \"value\": 1 },\n  \"rewards\": { \"xp\": 50, \"points\": 100 },\n  \"rarity\": \"comun\"\n}" },
        "description": "Crear un nuevo achievement (protected)."
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Achievement created', function () { pm.response.to.have.status(201); });", "try { var json = pm.response.json(); if (json && json.data && (json.data._id || json.data.id)) pm.collectionVariables.set('achievementId', json.data._id || json.data.id); } catch (e) {}" ] } } ]
    },
    {
      "name": "Update Challenge",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/challenges/{{challengeId}}", "host": ["{{baseUrl}}"], "path": ["api","challenges","{{challengeId}}"] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Reto actualizado\"\n}" },
        "description": "Actualizar un challenge por ID (protegido)."
      }
    },
    {
      "name": "Delete Challenge",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/challenges/{{challengeId}}", "host": ["{{baseUrl}}"], "path": ["api","challenges","{{challengeId}}"] },
        "description": "Eliminar (soft delete) un challenge por ID (protegido)."
      }
    },
    {
      "name": "List Achievements",
      "request": {
        "method": "GET",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/achievements", "host": ["{{baseUrl}}"], "path": ["api","achievements"] },
        "description": "Lista de logros/achievements disponibles."
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "challengeId", "value": "" }
  ]
}
